# Copie para .env (cp .env.example .env) e preencha. Nunca versione o .env.

# --- Provedor de LLM ---
# openrouter = chamadas reais | fake = respostas simuladas, roda sem chave
LLM_PROVIDER=fake
# Chave do OpenRouter (https://openrouter.ai/keys). Localmente vem do .env; no deploy fica vazia e o usuário informa na sessão
OPENROUTER_API_KEY=
# Chave administrativa para criar/editar/remover clientes, tickets e prompts na API (em deploy, inserida na sessão)
ADMIN_API_KEY=
# Endpoint compatível com OpenAI (troque para usar outro provedor, ex.: DeepSeek)
LLM_BASE_URL=https://openrouter.ai/api/v1
# Modelo usado na geração (gratuito; a Etapa 1 confirma o padrão). Alternativa: nvidia/nemotron-3.5-super-vl:free
LLM_MODEL=baidu/ernie-5.5-flash-preview:free
# Temperatura baixa = respostas mais estáveis e comparáveis
LLM_TEMPERATURE=0.1
# Limite de tokens da resposta. Modelos de raciocínio gastam milhares de tokens antes do JSON: com menos, a resposta vem vazia
LLM_MAX_TOKENS=12000
# Tempo máximo por chamada, em segundos
LLM_TIMEOUT_S=90
# Novas tentativas em erro temporário (429/5xx)
LLM_MAX_RETRIES=2
# Formato da saída: json_schema | json_object | prompt
LLM_STRUCTURED_MODE=json_schema
# Raciocínio: default (não envia) | off | none | low | medium | high. O modelo padrão tem raciocínio obrigatório e recusa off e none (ADR 0027)
LLM_REASONING=default

# --- Prompts e dados ---
# Pasta dos prompts versionados
PROMPTS_DIR=prompts
# Pasta com profiles.json e tickets.json
CATALOG_DIR=catalog
# Pasta onde ficam execuções, cache e comparações
DATA_DIR=var
# Salva as mensagens enviadas ao modelo em cada execução (auditoria)
SAVE_PROMPT_MESSAGES=true
# Tamanho máximo do texto do ticket
MAX_TICKET_CHARS=4000
# Fuso dos timestamps gravados
APP_TIMEZONE=America/Sao_Paulo

# --- Servidor web ---
HOST=127.0.0.1
PORT=9713
# Chamadas por minuto, por IP, em generate na API (protege a cota). 0 desliga
RATE_LIMIT_PER_MIN=10
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log de eventos (JSON Lines): cada geração, lote, avaliação e comparação vira uma linha
LOG_FILE=fellowsupport.log
# URL pública do site (vazio em ambiente local)
PUBLIC_URL=
